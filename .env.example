# SWIFT Address Extraction — Phase 1 environment variable names ONLY.
#
# Copy to `.env` for local development and fill in real values there.
# `.env` is git-ignored. NEVER commit real credentials.
# The code reads os.environ directly, so exporting these in the shell (or
# supplying them via the enterprise secret-management mechanism) works without
# a .env file — that is the expected route for any non-local run.

# ---------------------------------------------------------------------------
# Gemini model selection
# ---------------------------------------------------------------------------
# Model ID used for extraction. Overrides `model.default_model` in config.yaml.
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Credentials — Gemini Developer API
# ---------------------------------------------------------------------------
# The Google Gen AI SDK reads GEMINI_API_KEY (preferred) or GOOGLE_API_KEY.
# Leave both unset to force the pipeline into dry-run / mock mode.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Credentials — Vertex AI / enterprise configuration (alternative to the above)
# ---------------------------------------------------------------------------
# Set GOOGLE_GENAI_USE_VERTEXAI=true to route the same code through Vertex AI
# using Application Default Credentials. No source change is required.
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---------------------------------------------------------------------------
# Pipeline overrides (all optional; config.yaml supplies defaults)
# ---------------------------------------------------------------------------
# Force mock extraction even when credentials are present ("true"/"false").
# SWIFT_ADDRESS_DRY_RUN=false

# Path to the runtime configuration file. Relative values resolve against the
# model root (models/swft_tc/), never against the working directory.
# SWIFT_ADDRESS_CONFIG=config/config.yaml

# Path to the group configuration file (CSV or YAML). Same resolution rule.
# SWIFT_ADDRESS_GROUP_CONFIG=config/group_config.csv

# Allow raw (unhashed) addresses in DEBUG logs. Defaults to false.
# Only enable inside an approved, access-controlled debugging environment:
# this data may contain customer/payment addresses.
# SWIFT_ADDRESS_ALLOW_RAW_LOGS=false
